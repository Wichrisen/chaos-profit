# =============================================================================
# Chaos & Profit - Python / Pygame Project .gitignore
# =============================================================================

# --------------------
# Python
# --------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --------------------
# Virtual environments
# --------------------
.venv/
venv/
ENV/
env/
.conda/
.conda-env/

# --------------------
# IDE / Editors
# --------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --------------------
# macOS
# --------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# --------------------
# Windows
# --------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --------------------
# Game specific
# --------------------
# Player saves (never commit these)
saves/
*.sav
*.save

# Logs and temporary files
*.log
*.tmp
*.bak
*~
.#*

# PyInstaller build artifacts (we keep the .spec file, but not build outputs)
*.spec.bak
build/
dist/

# --------------------
# Testing & Coverage
# --------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --------------------
# Packaging / Release
# --------------------
# We usually keep the main .spec file under version control
# Only ignore backup spec files
*.spec~

# --------------------
# Other
# --------------------
# Temporary audio conversion artifacts
*.wav.bak
*.ogg.bak

# --------------------
# Personal / Tools
# --------------------
# Scripts and tools that are not part of the distributed game
tools/

# Local AI / development notes (not for public repo)
RECENTLY_MOVES.md